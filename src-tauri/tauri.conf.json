{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "henkanhakase",
  "version": "0.1.0",
  "identifier": "net.utcode.henkanhakase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "henkanhakase",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "../LICENSE": "LICENSE",
      "licenses/FFmpeg-COPYING.GPLv3.txt": "licenses/FFmpeg-COPYING.GPLv3.txt",
      "licenses/FFmpeg-COPYING.LGPLv2.1.txt": "licenses/FFmpeg-COPYING.LGPLv2.1.txt",
      "licenses/FFmpeg-COPYING.LGPLv3.txt": "licenses/FFmpeg-COPYING.LGPLv3.txt",
      "licenses/FFmpeg-NOTICE.txt": "licenses/FFmpeg-NOTICE.txt",
      "licenses/THIRD_PARTY_LICENSES_FRONTEND.txt": "licenses/THIRD_PARTY_LICENSES_FRONTEND.txt",
      "licenses/THIRD_PARTY_LICENSES_OTHER.txt": "licenses/THIRD_PARTY_LICENSES_OTHER.txt",
      "licenses/THIRD_PARTY_LICENSES_RUST.txt": "licenses/THIRD_PARTY_LICENSES_RUST.txt"
    }
  }
}
